# Antigravity CLI Portable - Git Ignore

# Korisnički profil i sesije (privatni podaci i tokeni)
data/
.gemini/
.antigravity/
*.token
*.session

# Servisni kartoni klijentskih računara i offline red čekanja (privatni podaci klijenata)
devices/
pending_sync/

# Lokalno generisane kontrolne sume i USB vakcinacija
config/checksums.json
autorun.inf/

# Izvršni fajlovi (veliki binarni fajlovi se preuzimaju na USB)
bin/*.exe
!bin/README_BIN.md

# Logovi i privremeni fajlovi
logs/
*.log
*.tmp
*.bak
temp/
tmp/

# Python test keš
__pycache__/
*.py[cod]
.pytest_cache/

# Windows sistemski fajlovi
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Skripte generisani izveštaji i dumpovi
reports/
*.dmp
*.evtx
